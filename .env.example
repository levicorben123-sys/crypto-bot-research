# No API keys needed — this runs entirely on Kraken's public market data with a
# locally simulated portfolio. Copy this to .env only if you want to override defaults.

# Kraken pair to trade, e.g. XBTUSD (BTC/USD), ETHUSD (ETH/USD)
PAIR=XBTUSD

# Kraken OHLC candle size in minutes: 1, 5, 15, 30, 60, 240, 1440, 10080, 21600
# Kraken's public OHLC endpoint only returns ~720 candles of history, so a larger
# interval gives more backtest coverage (e.g. 240 -> ~120 days, 1440 -> ~2 years).
# 1440 (daily) per README Round 9 - the strategy was only validated at daily resolution;
# it failed badly when tested at 15m and 1m on real Kraken data. Don't lower this without
# re-validating at that resolution first.
INTERVAL_MINUTES=1440

# Simulated starting balance in quote currency (USD)
STARTING_CASH=10000

# Strategy parameters
FAST_MA_PERIOD=10
SLOW_MA_PERIOD=30
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Exit rule: sell at +TAKE_PROFIT_PCT or -STOP_LOSS_PCT from entry, whichever hits first
# Defaults per README Round 8 (validated across 4 independent BTC regime splits,
# 2014-2026) - a bounded-loss, positive-expectancy design, NOT a buy-and-hold beater in
# bull markets. See README before changing.
TAKE_PROFIT_PCT=20.0
STOP_LOSS_PCT=1.0

# Kraken taker fee per trade side (~0.26% is typical) — applied on both buy and sell
FEE_PCT=0.26

# How often the live loop checks for a new signal, in seconds
POLL_INTERVAL_SECONDS=60
